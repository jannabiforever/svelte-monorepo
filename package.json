{
  "name": "@/root",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --sort --bail build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r exec rm -rf dist .svelte-kit node_modules"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0"
  }
}
